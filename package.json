{
  "name": "ariavel-sourcing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "server:dev": "tsx src/server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@mondaycom/apps-cli": "^1.0.0",
    "@mondaycom/apps-sdk": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "monday-sdk-js": "^0.5.9",
    "mongodb": "^7.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
